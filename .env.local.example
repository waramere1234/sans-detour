# Sans Détour — variables d'environnement
# Copier en .env.local et remplir avec tes vraies valeurs.
# .env.local est gitignored, ne le commit pas.

# ─── Supabase ──────────────────────────────────────────────────────────────
# Récupérables dans dashboard.supabase.com → ton projet → Settings → API.
# Les versions VITE_* sont publiques (RLS read-only sur la table scrutins).

VITE_SUPABASE_URL=https://TON-PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbG...

# Versions sans préfixe VITE_, utilisées par les scripts Node uniquement.
# La clé service_role bypass RLS — ne JAMAIS la mettre dans le bundle client.
SUPABASE_URL=https://TON-PROJET.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...

# ─── Anthropic (pour scripts/ingest-an.ts) ─────────────────────────────────
# console.anthropic.com → Settings → API Keys
# Coût estimé : ~$0.20-0.30 par run d'ingestion (Haiku 4.5 + Batches API).

ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── Plausible (optionnel, analytics) ──────────────────────────────────────
# Si non set, le script Plausible n'envoie rien.

VITE_PLAUSIBLE_DOMAIN=sansdetour.fr
